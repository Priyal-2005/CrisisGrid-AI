# CrisisGrid AI — Environment Variables
# Copy this to .env and fill in your keys.

# ── API Keys ──
# Groq API key (free tier: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# ── Backend Settings (FastAPI) ──
HOST=0.0.0.0
PORT=8000
DEBUG=false
ENV=production

# Comma-separated list of allowed origins for CORS (e.g., https://your-frontend.vercel.app)
CORS_ORIGINS=*

# ── Frontend Settings (Next.js) ──
# Change these for production deployment
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws